# Credentials. Never.
.env
.env.*
.admin.env
!.env.example
*.pem
*.key

# Generated reports carry live Atlassian account ids, issue keys, branch names
# and named individuals. Generated on demand; must never enter git history --
# report/ holds the code that produces them, which is the part worth reviewing.
/reports/*
/out/
*.xlsx
*.ndjson

# Daily-report source files: personal data, arrive from outside the repo.
/inbox/

# Poller watermarks -- machine state, not source.
/state/

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
.pytest_cache/

# npx client build artefacts
node_modules/
cli/dist/

# Server operational state: the whitelist is fingerprints, not secrets, but it
# is still the list of everyone being measured and it belongs in /etc on the box.
/server/allowed.env
allowed.env

# Built client archives. `tools/build_pyz.py` writes here and the release job
# attaches what it finds; a .pyz in git history is a binary nobody can review
# and a second source of truth for what "the current client" is.
/dist/
*.pyz


# Sample data
samples
# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/

# The dashboard snapshot. Same reason as /reports/*: it carries named
# individuals, Jira issue keys and AIO cycle keys. It is generated by
# report/dashboard_data.py where the credentials are and shipped with the
# deploy -- it is a build artefact of live data, not source.
/server/assets/insights.json

# The built screens ARE committed, deliberately: the deploy is a tar copy onto
# a box with no Node toolchain, so the bundle has to travel with the code.
# They hold no personal data -- the figures arrive at runtime from the
# snapshot above, which does not travel with git.

# The publisher's config. It names individuals and carries their Atlassian
# account ids and the endpoint's hostname, so it is data like
# reports/identities.txt is -- already covered by /reports/* above, and named
# here so nobody re-adds it by hand. reports/dashboard.json.example is the
# tracked shape, with invented names.
/reports/dashboard.json
!/reports/dashboard.json.example
