# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# These are the names the code actually reads (common/__init__.py,
# Config.from_env). A name that is not on this list is not read by anything.

# --- Jira ---
JIRA_URL=https://acme.jira.com
JIRA_USERNAME=              # the Atlassian account email
JIRA_API_TOKEN=

# The real project keys, comma-separated. Without this, anything shaped like a
# key is accepted: measured on a live repository, `fix/AUG-25` yielded the
# ticket "AUG-25", which is a date, and fabricated keys outnumbered real ones
# 14 to 5. `poll_jira.py --dump-projects` asks Jira for the list.
JIRA_PROJECT_KEYS=IML,APR,AERLABS

# --- Bitbucket Cloud ---
BITBUCKET_USERNAME=         # the username, not the email
BITBUCKET_ACCESS_TOKEN=     # app password or access token

# --- AIO TCMS ---
# Its own key. AIO rejects the Jira token with 401, and the scheme is AioAuth,
# not Basic. AIO Tests > API Keys.
AIO_API_TOKEN=
AIO_BASE_URL=https://tcms.aiojiraapps.com

# --- Hashing ---
# Per-deployment salt for person_email_hash. Without it no hash is emitted at
# all, rather than an unsalted one: SHA-256 of a corporate address is trivially
# reversible. Rotating it breaks every historical join.
AIEP_TELEMETRY_SALT=

# --- Reading bundles back from the endpoint (importers/pull.py) ---
INSIGHT_ENDPOINT=http://127.0.0.1:8479
INSIGHT_ADMIN_TOKEN=

# --- The daybook: a browser page on the endpoint's read listener ---
# Presence typed in by hand, beside each person's AI activity as a
# contribution calendar. Opt-in: with no passcode set the routes do not exist
# and an existing deployment is untouched.
#
# Loopback only, reached over an SSH tunnel:
#     ssh -L 8479:127.0.0.1:8479 <host>   then http://127.0.0.1:8479/dashboard
#
# A passcode is a weaker credential than INSIGHT_ADMIN_TOKEN beside it, which
# is exactly why the page is never on the public listener. Prefer the _FILE
# form on a host where `docker inspect` is readable by more than root.
# INSIGHT_DASHBOARD_PASSWORD=
# INSIGHT_DASHBOARD_PASSWORD_FILE=/etc/insight/daybook.passcode
#
# Where attendance is kept: <email> <date> <in|out|off> <in> <out>, tab
# separated. Goes in the *writable* registry mount beside roster.txt, never
# beside the admin token. Required once a passcode is set -- a page whose only
# writable half silently does nothing is worse than one that was never served.
# INSIGHT_ATTENDANCE_FILE=/var/lib/insight-registry/attendance.tsv
#
# Which local day an event belongs to. Event times are UTC; a working day is
# not. Same variable the watchdog reads.
# INSIGHT_TZ_OFFSET=+07:00

# --- The endpoint itself. Lives on the server, in /etc/insight/proxy.env. ---
# INSIGHT_STORE=s3://aeris-insight
# INSIGHT_ALLOWED_FILE=/etc/insight/allowed.env
# INSIGHT_ADMIN_TOKEN_FILE=/etc/insight/admin.token
# INSIGHT_HOST=127.0.0.1
# INSIGHT_PORT=8479
# INSIGHT_UPLOAD_PORT=8480
# AWS_REGION=ap-southeast-1
