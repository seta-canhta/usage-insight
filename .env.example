# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Jira / Atlassian ---
JIRA_BASE_URL=https://acme.jira.com
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Bitbucket Cloud ---
BITBUCKET_WORKSPACE=acme
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# --- AIO TCMS (separate key from the Jira token; enabled per Jira project) ---
AIO_BASE_URL=https://tcms.aiojiraapps.com/aio-tcms/api/v1
AIO_TOKEN=

# --- Hashing salt for person_email_hash (CONTRACT.md 11.3). Rotate = break joins. ---
TELEMETRY_HASH_SALT=

# --- The collection endpoint itself (server/ only; see server/README.md) ---
# Lives in /etc/insight/proxy.env on the server, chmod 600, never in git.
# INSIGHT_STORE=s3://aeris-insight            # no prefix: keys already start with bundles/
# INSIGHT_ALLOWED_FILE=/etc/insight/allowed.env   # one email:fingerprint per line
# INSIGHT_ADMIN_TOKEN_FILE=/etc/insight/admin.token  # preferred in a container:
#   `docker inspect` prints the environment to anyone who can reach the daemon
# INSIGHT_HOST=127.0.0.1                      # the reverse proxy faces the internet, not this
# INSIGHT_PORT=8479                           # uploads AND the read routes
# INSIGHT_UPLOAD_PORT=8480                    # uploads and /healthz only. Publish
#   this one when the TLS terminator is on another machine and forwards every path.
# AWS_REGION=ap-southeast-1                   # credentials: prefer an instance role

# --- Deploying with server/compose.yaml (Docker; see server/README.md) ---
# Only needed on a host where something else already owns 443.
# INSIGHT_EDGE_NETWORK=                       # the reverse proxy's docker network
# INSIGHT_SRC=./src                           # repo checkout
# INSIGHT_CONF=./etc                          # allowed.env, admin.token, roster.txt
# INSIGHT_DATA=./data                         # only used by the file:// store
# INSIGHT_STATE=./state                       # the watchdog's "already alerted" memory
# INSIGHT_PUBLISH=192.168.x.y:8479            # host address for an off-box gateway;
#   LAN interface, never a bare port.
# INSIGHT_PUBLISHED_PORT=8480                 # which listener sits behind it:
#   8480 = uploads and /healthz only (default). 8479 = the read routes too,
#   which puts the whole team's telemetry behind the admin token alone.
# INSIGHT_WATCH_INTERVAL=3600                 # how often the watchdog looks

# --- Collection endpoint (central side only; see docs/TRANSPORT.md) ---
# Where importers/pull.py fetches weekly bundles from.
# Over an SSH tunnel -- the read routes are loopback-only on the server.
#   ssh -N -L 8479:127.0.0.1:8479 aeris-insight.seta-international.com &
INSIGHT_ENDPOINT=http://127.0.0.1:8479
# Reads expose every engineer at once, so this route is admin-only.
INSIGHT_ADMIN_TOKEN=

# --- Watchdog: notice when a machine stops reporting (importers/watch.py) ---
# Working hours, so nights and weekends are not counted as missed reports and
# nobody is alerted at 02:00 on a Sunday.
INSIGHT_WORK_START=09:00
INSIGHT_WORK_END=19:00
# Monday=0 .. Sunday=6
INSIGHT_WORK_DAYS=0,1,2,3,4
# Fixed offset, not a tz name: Vietnam is UTC+7 with no daylight saving, so this
# is exact and needs no tz database present on the machine running the check.
INSIGHT_TZ_OFFSET=+07:00
# Consecutive *working days* with no bundle at all before an alert. Days, not
# hours: an idle hour uploads nothing by design, but an idle day still uploads
# one empty bundle -- so a silent day means collection is broken.
INSIGHT_MISS_THRESHOLD=3
INSIGHT_NTFY_URL=https://ntfy.sh/seta-insight
# Only if the topic is access-protected. ntfy.sh public topics need no token --
# and anyone who knows the topic name can read it, so do not put names in it.
INSIGHT_NTFY_TOKEN=
